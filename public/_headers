# Netlify custom headers. Apply to files served from the publish directory;
# edge-function responses set their own headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Link: </_md/index.md>; rel="alternate"; type="text/markdown"
  Link: </llms.txt>; rel="alternate"; type="text/plain"
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </.well-known/ard.json>; rel="ard"
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog"

# Pre-rendered markdown documents (also returned by the Accept negotiation edge function)
/_md/*
  Content-Type: text/markdown; charset=utf-8
  Vary: Accept
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Static, read-only JSON API
/api/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Discovery documents
/.well-known/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/.well-known/api-catalog
  Content-Type: application/linkset+json

/.well-known/ard.json
  Content-Type: application/json; charset=utf-8

/.well-known/ai-catalog.json
  Content-Type: application/json; charset=utf-8

/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8

/.well-known/agent-skills/:skill/SKILL.md
  Content-Type: text/markdown; charset=utf-8

# Vite writes content-hashed JS/CSS into /assets/, so those filenames can never
# point at different bytes and are safe to cache forever.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# public/assets/* keeps its original filenames, so replacing a photo reuses its
# URL. These must stay revalidatable or visitors would hold the old image.
/assets/photography/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/about-harsh.webp
  Cache-Control: public, max-age=86400, must-revalidate

# Hover-preview thumbnails: same reasoning, regenerated in place.
/previews/*
  Cache-Control: public, max-age=86400, must-revalidate
